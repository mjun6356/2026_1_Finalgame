  characterName: "\uCCA0\uC218"
  characterImage: {fileID: -3848671675706844320, guid: 18f8b7e321b8d8f42aa82a5669e226bf, type: 3}
  dialogueLines:
  - "\uC548\uB155 \uB098\uB294 \uCCA0\uC218, \uB9CC\uC77C\uB0B4\uAC8C \uBB3C\uC5B4\uBCF8\uB2E4\uBA74
    \uD68C\uC0AC\uC6D0\uC774\uB2E4."
  - "\uC544\uBB34\uB3C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC \uB098\uB294 \uC5B4\uB838\uC744
    \uB54C \uC628\uAC16 \uC77C\uC744 \uD588\uC5C8\uB2E4."
  - "\uC6B0\uC8FC\uC120\uC5D0\uC11C \uC6B4\uC11D\uB9DE\uAE30, \uB5A8\uC5B4\uC9C0\uB294
    \uC6B0\uC8FC\uC120\uC744 \uD5A5\uD574 \uCD08\uC18D 30\uB9CC\uD0A4\uB85C\uC758
    \uBE5B\uC744 \uC3D8\uAE30, \n\uCCB4\uC9C0\uBC29\uB960 5%, \uACE8\uACA9\uADFC\uB7C990\uD0A4\uB85C\uC5D0
    \uB2EC\uD558\uB294 \n\uC601\uD76C\uC640\uC758 \uB7EC\uBE0C \uC904\uB2E4\uB9AC\uAE30
    \uB4F1\uB4F1.."
  - "\uC9D1\uC5D0 \uAC00\uBA74 \uC788\uC744 \uC601\uD76C\uAC00 \uBB34\uC12D\uB2E4."
  - "\uB0B4\uAC00 \uC88B\uC544\uD558\uB294\uAC74 \uC2A4\uD0C0\uD0B9\uC774\uB77C\uACE0
    \uC2A4\uD1A0\uD0B9\uC774 \uC544\uB2C8\uB77C"
  - "\uADF8\uB798\uB3C4 \uC9D1\uC5D0\uAC00\uC57C\uD55C\uB2E4."
  - "\uC65C\uB0D0\uACE0 \uBB3C\uC5B4\uBCF8\uB2E4\uBA74"
  - "\uC9D1\uC774 \uADF8\uACF3\uC5D0 \uC788\uC5C8\uC73C\uB2C8\uAE4C"
  choice: []
